    async def evaluate_content(self, content: str, topic: str, content_type: str, target_audience: str) -> Dict:
        """
        Comprehensive content evaluation using multiple assessment frameworks
        """
        try:
            logger.info(f"Starting comprehensive evaluation for: {topic}")
            
            # Parallel evaluation tasks
            evaluation_tasks = [
                self._evaluate_eeat(content, topic, target_audience),
                self._evaluate_content_quality(content, topic, content_type),
                self._evaluate_seo_factors(content, topic),
                self._analyze_entities_and_clusters(content, topic),
                self._find_reddit_insights(topic),
                self._evaluate_ymyl_factors(content, topic)
            ]
            
            results = await asyncio.gather(*evaluation_tasks, return_exceptions=True)
            
            # Compile comprehensive evaluation
            evaluation_report = {
                "overall_score": 0,
                "eeat_analysis": results[0] if not isinstance(results[0], Exception) else {},
                "content_quality": results[1] if not isinstance(results[1], Exception) else {},
                "seo_analysis": results[2] if not isinstance(results[2], Exception) else {},
                "entity_analysis": results[3] if not isinstance(results[3], Exception) else {},
                "reddit_insights": results[4] if not isinstance(results[4], Exception) else {},
                "ymyl_assessment": results[5] if not isinstance(results[5], Exception) else {},
                "recommendations": [],
                "entity_clusters": {},
                "content_gaps": [],
                "optimization_suggestions": []
            }
            
            # Calculate overall score
            evaluation_report["overall_score"] = self._calculate_overall_score(evaluation_report)
            
            # Generate recommendations
            evaluation_report["recommendations"] = await self._generate_recommendations(evaluation_report, content, topic)
            
            logger.info(f"Evaluation completed. Overall score: {evaluation_report['overall_score']}")
            return evaluation_report
            
        except Exception as e:
            logger.error(f"Evaluation error: {e}")
            return {"error": str(e), "overall_score": 0}
    
    async def _evaluate_eeat(self, content: str, topic: str, target_audience: str) -> Dict:
        """Evaluate E-E-A-T factors using AI analysis"""
        
        eeat_prompt = f"""
        Evaluate this content for E-E-A-T (Experience, Expertise, Authoritativeness, Trustworthiness) factors:

        CONTENT TO EVALUATE:
        {content[:3000]}...

        TOPIC: {topic}
        TARGET AUDIENCE: {target_audience}

        Rate each E-E-A-T factor (1-10) and provide specific evidence:

        EXPERIENCE (Does content show first-hand experience?):
        - Personal anecdotes or case studies present?
        - Practical examples from real usage?
        - Behind-the-scenes insights?
        
        EXPERTISE (Does content demonstrate deep knowledge?):
        - Technical accuracy and depth?
        - Industry-specific knowledge?
        - Advanced concepts explained clearly?
        
        AUTHORITATIVENESS (Does content establish authority?):
        - Author credentials mentioned?
        - Quality external sources cited?
        - Recognition indicators present?
        
        TRUSTWORTHINESS (Is content trustworthy?):
        - Transparent sourcing?
        - Balanced perspective?
        - Fact-checking evidence?

        Provide scores and specific evidence for each factor in JSON format.
        """
        
        try:
            response = await self.openai_client.generate_content(eeat_prompt, max_tokens=1000)
            # Parse AI response to extract structured E-E-A-T analysis
            return self._parse_eeat_response(response)
        except Exception as e:
            logger.error(f"E-E-A-T evaluation error: {e}")
            return {"experience": 5, "expertise": 5, "authoritativeness": 5, "trustworthiness": 5}
    
