    def _calculate_overall_score(self, evaluation: Dict) -> float:
        """Calculate weighted overall content score with GPT-5 enhancements"""
        try:
            scores = []
            weights = []
            
            # E-E-A-T scores (40% weight)
            eeat = evaluation.get("eeat_analysis", {})
            if eeat:
                eeat_score = (
                    eeat.get("experience", 6) * 0.25 +
                    eeat.get("expertise", 6) * 0.25 +
                    eeat.get("authoritativeness", 6) * 0.25 +
                    eeat.get("trustworthiness", 6) * 0.25
                )
                scores.append(eeat_score)
                weights.append(0.4)
            
            # Content quality (30% weight)
            quality = evaluation.get("content_quality", {})
            if quality:
                quality_score = (
                    quality.get("originality", 6) * 0.25 +
                    quality.get("comprehensiveness", 6) * 0.25 +
                    quality.get("user_value", 6) * 0.25 +
                    quality.get("readability", 6) * 0.25
                )
                scores.append(quality_score)
                weights.append(0.3)
            
            # SEO factors (20% weight)
            seo = evaluation.get("seo_analysis", {})
            if seo:
                seo_score = (
                    seo.get("search_intent", 6) * 0.4 +
                    seo.get("content_structure", 6) * 0.3 +
                    seo.get("keyword_optimization", 6) * 0.3
                )
                scores.append(seo_score)
                weights.append(0.2)
            
            # YMYL compliance (10% weight if applicable)
            ymyl = evaluation.get("ymyl_assessment", {})
            if ymyl.get("is_ymyl", False):
                ymyl_score = ymyl.get("compliance_score", 6)
                scores.append(ymyl_score)
                weights.append(0.1)
            
            if not scores:
                return 6.0
            
            # Calculate weighted average
            total_weight = sum(weights)
            if total_weight > 0:
                weighted_score = sum(score * weight for score, weight in zip(scores, weights)) / total_weight
                return round(weighted_score, 1)
            
            return 6.0
            
        except Exception as e:
            logger.error(f"Score calculation error: {e}")
            return 6.0
    
