    async def _evaluate_ymyl_factors(self, content: str, topic: str) -> Dict:
        """Evaluate Your Money or Your Life content factors"""
        
        # Determine if this is YMYL content
        ymyl_keywords = [
            'health', 'medical', 'finance', 'investment', 'legal', 'safety', 
            'nutrition', 'medication', 'treatment', 'money', 'insurance',
            'security', 'privacy', 'parenting', 'emergency'
        ]
        
        is_ymyl = any(keyword in topic.lower() for keyword in ymyl_keywords)
        
        if not is_ymyl:
            return {"is_ymyl": False, "assessment": "Not YMYL content"}
        
        ymyl_prompt = f"""
        This appears to be YMYL (Your Money or Your Life) content about "{topic}".
        Evaluate for YMYL compliance:

        CONTENT: {content[:2000]}...

        YMYL ASSESSMENT:
