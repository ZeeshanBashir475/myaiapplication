    def _parse_eeat_response(self, response: str) -> Dict:
        """Parse GPT-5 response for E-E-A-T scores"""
        try:
            scores = {}
            factors = ["experience", "expertise", "authoritativeness", "trustworthiness"]
            
            for factor in factors:
                # Multiple patterns to catch different score formats
                patterns = [
                    rf"{factor}.*?(\d+(?:\.\d+)?)/10",
                    rf"{factor}.*?(\d+(?:\.\d+)?)\s*out\s*of\s*10",
                    rf"{factor}.*?score.*?(\d+(?:\.\d+)?)",
                    rf"{factor}.*?(\d+(?:\.\d+)?)"
                ]
                
                score_found = False
                for pattern in patterns:
                    match = re.search(pattern, response, re.IGNORECASE)
                    if match:
                        score = float(match.group(1))
                        # Ensure score is in valid range
                        scores[factor] = max(1.0, min(10.0, score))
                        score_found = True
                        break
                
                if not score_found:
                    scores[factor] = 6.0  # Default score
            
            return scores
        except Exception as e:
            logger.error(f"E-E-A-T parsing error: {e}")
            return {"experience": 6, "expertise": 6, "authoritativeness": 6, "trustworthiness": 6}
    
