    def _parse_ymyl_response(self, response: str, is_ymyl: bool) -> Dict:
        """Parse GPT-5 response for YMYL assessment"""
        try:
            if not is_ymyl:
                return {"is_ymyl": False, "compliance_score": 10}
            
            # Extract compliance score
            patterns = [
                r"compliance.*?(\d+(?:\.\d+)?)/10",
                r"compliance.*?(\d+(?:\.\d+)?)\s*out\s*of\s*10",
                r"score.*?(\d+(?:\.\d+)?)",
                r"rate.*?(\d+(?:\.\d+)?)"
            ]
            
            compliance_score = 6.0
            for pattern in patterns:
                match = re.search(pattern, response, re.IGNORECASE)
                if match:
                    compliance_score = max(1.0, min(10.0, float(match.group(1))))
                    break
            
            return {
                "is_ymyl": True,
                "compliance_score": compliance_score,
                "assessment": response[:800] + "..." if len(response) > 800 else response
            }
        except Exception as e:
            logger.error(f"YMYL parsing error: {e}")
            return {"is_ymyl": is_ymyl, "compliance_score": 6}
    
    def _parse_recommendations(self, response: str) -> List[str]:
        """Parse GPT-5 response for recommendations"""
        try:
            recommendations = []
            lines = response.split('\n')
            
            for line in lines:
                line = line.strip()
                # Match numbered lists, bullet points, or clear recommendation patterns
                if re.match(r'^\d+\.', line):
                    recommendations.append(line)
                elif line.startswith(('-', '•', '*')):
                    recommendations.append(line[1:].strip())
                elif len(line) > 20 and any(word in line.lower() for word in ['add', 'include', 'improve', 'enhance', 'optimize', 'create', 'develop', 'expand']):
                    recommendations.append(line)
            
            # Clean up and limit recommendations
            cleaned_recommendations = []
            for rec in recommendations[:15]:  # Limit to 15 recommendations
                if len(rec) > 10:  # Ensure substantial recommendations
                    cleaned_recommendations.append(rec)
            
            return cleaned_recommendations if cleaned_recommendations else ["Review content manually for improvement opportunities"]
        except Exception as e:
            logger.error(f"Recommendations parsing error: {e}")
            return ["Unable to parse recommendations - review evaluation manually"]
    
    def _extract_list_from_response(self, response: str, section_name: str) -> List[str]:
        """Extract lists from GPT-5 response based on section name"""
        try:
            items = []
            lines = response.split('\n')
            in_section = False
            
            for line in lines:
                line = line.strip()
                if section_name.lower() in line.lower():
                    in_section = True
                    continue
                
                if in_section:
                    if line.startswith(('-', '•', '*')):
                        item = line[1:].strip()
                        if item:
                            items.append(item)
                    elif re.match(r'^\d+\.', line):
                        item = line.split('.', 1)[1].strip()
                        if item:
                            items.append(item)
                    elif line and line[0].isupper() and len(line) > 5:
                        # Stop if we hit another section header
                        if ':' in line and len(items) > 0:
                            break
                        items.append(line)
            
            return items[:25]  # Limit to 25 items
        except Exception as e:
            logger.error(f"List extraction error: {e}")
            return []

class KnowledgeGraphAgent:
    """Agent for Google Knowledge Graph integration"""
    
    def __init__(self, api_key: str = None):
        self.api_key = api_key
        self.base_url = "https://kgsearch.googleapis.com/v1/entities:search"
    
    async def get_entity_connections(self, entities: List[str]) -> Dict:
        """Get entity connections from Google Knowledge Graph"""
        if not self.api_key:
            return {
                "entity_connections": [],
                "related_topics": [],
                "knowledge_panels": [],
                "error": "No Google Knowledge Graph API key provided"
            }
        
        try:
            all_entities = []
            for entity in entities[:5]:  # Limit to avoid rate limiting
                response = await self._search_entity(entity)
                if response.get('entities'):
                    all_entities.extend(response['entities'])
            
            return {
                "entity_connections": all_entities,
                "related_topics": self._extract_related_topics(all_entities),
                "knowledge_panels": self._extract_knowledge_panels(all_entities)
            }
        except Exception as e:
            logger.error(f"Knowledge Graph error: {e}")
            return {"entity_connections": [], "error": str(e)}
    
    async def _search_entity(self, query: str) -> Dict:
        """Search for a specific entity in Google Knowledge Graph"""
        if not self.api_key:
            return {"entities": []}
        
        try:
            params = {
                'query': query,
                'key': self.api_key,
                'limit': 5,
                'indent': True
            }
            
            response = requests.get(self.base_url, params=params, timeout=10)
            response.raise_for_status()
            
            data = response.json()
            entities = []
            
            for item in data.get('itemListElement', []):
                entity = item.get('result', {})
                entities.append({
                    'name': entity.get('name', ''),
                    'description': entity.get('description', ''),
                    'types': entity.get('@type', []),
                    'url': entity.get('url', ''),
                    'score': item.get('resultScore', 0)
                })
            
            return {"entities": entities}
        except Exception as e:
            logger.error(f"Entity search error: {e}")
            return {"entities": []}
    
    def _extract_related_topics(self, entities: List[Dict]) -> List[str]:
        """Extract related topics from entity data"""
        topics = set()
        for entity in entities:
            description = entity.get('description', '')
            if description:
                # Simple keyword extraction from descriptions
                words = description.split()
                for word in words:
                    if len(word) > 4 and word.isalpha():
                        topics.add(word.title())
        
        return list(topics)[:20]  # Return top 20 related topics
    
    def _extract_knowledge_panels(self, entities: List[Dict]) -> List[Dict]:
        """Extract knowledge panel information"""
        panels = []
        for entity in entities[:10]:  # Limit to 10 panels
            if entity.get('name'):
                panels.append({
                    'title': entity.get('name', ''),
                    'description': entity.get('description', ''),
                    'types': entity.get('types', []),
                    'url': entity.get('url', '')
                })
        
        return panels
    
    async def suggest_topic_clusters(self, main_topic: str) -> Dict:
        """Suggest content clusters based on Knowledge Graph data"""
        try:
            entity_data = await self._search_entity(main_topic)
            entities = entity_data.get('entities', [])
            
            if not entities:
                return {
                    "pillar_topics": [main_topic],
                    "cluster_topics": [],
                    "content_gaps": []
                }
            
            # Extract cluster suggestions from entity types and descriptions
            cluster_topics = []
            for entity in entities:
                types = entity.get('types', [])
                for entity_type in types:
                    if entity_type not in cluster_topics:
                        cluster_topics.append(entity_type.replace('Thing', '').replace('/', ' '))
            
            return {
                "pillar_topics": [main_topic],
                "cluster_topics": cluster_topics[:15],
                "content_gaps": self._identify_content_gaps(main_topic, cluster_topics)
            }
        except Exception as e:
            logger.error(f"Topic cluster suggestion error: {e}")
            return {"pillar_topics": [], "cluster_topics": [], "content_gaps": []}
    
    def _identify_content_gaps(self, main_topic: str, cluster_topics: List[str]) -> List[str]:
        """Identify potential content gaps"""
        gaps = [
            f"How to get started with {main_topic}",
            f"{main_topic} best practices and tips",
            f"Common {main_topic} mistakes to avoid",
            f"{main_topic} tools and resources",
            f"Advanced {main_topic} strategies"
        ]
        
        # Add cluster-specific gaps
        for topic in cluster_topics[:5]:
            gaps.append(f"{topic} guide for {main_topic}")
        
        return gaps[:10]
