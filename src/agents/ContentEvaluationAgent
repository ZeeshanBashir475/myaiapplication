    def _parse_eeat_response(self, response: str) -> Dict:
        """Parse AI response for E-E-A-T scores"""
        try:
            # Extract numerical scores from response
            scores = {}
            factors = ["experience", "expertise", "authoritativeness", "trustworthiness"]
            
            for factor in factors:
                pattern = rf"{factor}.*?(\d+(?:\.\d+)?)"
                match = re.search(pattern, response, re.IGNORECASE)
                if match:
                    scores[factor] = float(match.group(1))
                else:
                    scores[factor] = 5.0  # Default score
            
            return scores
        except Exception as e:
            logger.error(f"E-E-A-T parsing error: {e}")
            return {"experience": 5, "expertise": 5, "authoritativeness": 5, "trustworthiness": 5}
    
