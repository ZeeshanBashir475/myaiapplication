    def _parse_ymyl_response(self, response: str, is_ymyl: bool) -> Dict:
        """Parse AI response for YMYL assessment"""
        try:
            if not is_ymyl:
                return {"is_ymyl": False, "compliance_score": 10}
            
            # Extract compliance score
            pattern = r"compliance.*?(\d+(?:\.\d+)?)"
            match = re.search(pattern, response, re.IGNORECASE)
            compliance_score = float(match.group(1)) if match else 5.0
            
            return {
                "is_ymyl": True,
                "compliance_score": compliance_score,
                "assessment": response[:500] + "..." if len(response) > 500 else response
            }
        except Exception as e:
            logger.error(f"YMYL parsing error: {e}")
            return {"is_ymyl": is_ymyl, "compliance_score": 5}
    
    def _parse_recommendations(self, response: str) -> List[str]:
        """Parse AI response for recommendations"""
        try:
            # Extract numbered list items
            recommendations = []
            lines = response.split('\n')
            
            for line in lines:
                line = line.strip()
                if re.match(r'^\d+\.', line):
                    recommendations.append(line)
                elif line.startswith('-') or line.startswith('•'):
                    recommendations.append(line[1:].strip())
            
            return recommendations[:10]  # Limit to 10 recommendations
        except Exception as e:
            logger.error(f"Recommendations parsing error: {e}")
            return ["Unable to parse recommendations"]
    
    def _extract_list_from_response(self, response: str, section_name: str) -> List[str]:
        """Extract lists from AI response based on section name"""
        try:
            items = []
            lines = response.split('\n')
            in_section = False
            
            for line in lines:
                line = line.strip()
                if section_name.lower() in line.lower():
                    in_section = True
                    continue
                
                if in_section:
                    if line.startswith('-') or line.startswith('•'):
                        items.append(line[1:].strip())
                    elif re.match(r'^\d+\.', line):
                        items.append(line.split('.', 1)[1].strip())
                    elif line and not line[0].isalnum():
                        continue
                    elif line and len(items) > 0:
                        break
            
            return items[:20]  # Limit to 20 items
        except Exception as e:
            logger.error(f"List extraction error: {e}")
            return []

